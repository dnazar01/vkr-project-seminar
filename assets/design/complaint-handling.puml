@startuml
skinparam backgroundColor white
skinparam shadowing false
skinparam defaultFontName Arial
skinparam activity {
  BackgroundColor #F8FAFC
  BorderColor #334155
  DiamondBackgroundColor #FFF4D6
  DiamondBorderColor #B7791F
  ArrowColor #475569
}

|Заявитель|
start
:Отправить банковскую жалобу;

|Серверный компонент|
:Проверить запрос и зарегистрировать\nобщее задание по жалобе;

|Централизованное подразделение\nпо жалобам (вторая линия)|
:Проверить содержание, тему\nи комплектность материалов;
if (Тема и процесс\nвыбраны верно?) then (да)
else (нет)
  :Вручную скорректировать тему\nили ответственный процесс;
  if (Ответственный процесс изменён?) then (да)
    :Передать обращение в уточнённый\nпроцесс второй линии;
    stop
  else (нет)
  endif
endif
if (Нужны профильные сведения?) then (да)
  :Сформировать запрос сведений;
  |Профильное подразделение\n(вторая линия)|
  :Изучить вопрос и предоставить сведения;
  |Централизованное подразделение\nпо жалобам (вторая линия)|
  :Учесть полученные сведения;
else (нет)
endif
:Подготовить официальный ответ;

|Заявитель|
:Получить ответ допустимым способом;
stop
@enduml
